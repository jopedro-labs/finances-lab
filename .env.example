# ==============================================================================
# DIP DETECTOR CONFIGURATION
# ==============================================================================
MIN_DROP_PCT=5.0
MAX_DROP_PCT=10.0
LOOKBACK_DAYS=30

# ==============================================================================
# STOCK SCORING STRATEGY CONFIGURATION
# ==============================================================================
STOCK_DIP_MIN_PCT=5.0
STOCK_DIP_MAX_PCT=20.0

# Scoring criteria weights (MUST sum to exactly 1.0)
STOCK_WEIGHT_DIP=0.30
STOCK_WEIGHT_FORWARD_PE=0.30
STOCK_WEIGHT_52W_RANGE=0.15
STOCK_WEIGHT_ALLOCATION=0.25

# Target allocation gap scaling boundary (%)
STOCK_ALLOC_GAP_MAX_PCT=10.0

# ==============================================================================
# ETF SCORING STRATEGY CONFIGURATION
# ==============================================================================
# Scoring criteria weights (MUST sum to exactly 1.0)
ETF_WEIGHT_DIP=0.40
ETF_WEIGHT_TER=0.20
ETF_WEIGHT_ALLOCATION=0.40

# Optimal price dip window bounds (%)
ETF_DIP_MIN_PCT=5.0
ETF_DIP_MAX_PCT=10.0

# Total Expense Ratio (TER) thresholds (%)
ETF_TER_LOW_PCT=0.10
ETF_TER_HIGH_PCT=0.50

# Target allocation gap scaling boundary (%)
ETF_ALLOC_GAP_MAX_PCT=10.0

# ==============================================================================
# EXPOSURE PENALTY CONFIGURATION
# ==============================================================================
# Multiplicative penalty weights for policy limit breaches
EXPOSURE_SECTOR_PENALTY_WEIGHT=0.30
EXPOSURE_COUNTRY_PENALTY_WEIGHT=0.20

# ==============================================================================
# LOOK-THROUGH EXPOSURE POLICY LIMITS
# ==============================================================================
MAX_COUNTRY_ALLOCATION_PCT=60.0
MAX_TECH_ALLOCATION_PCT=50.0
MAX_OTHER_SECTOR_ALLOCATION_PCT=15.0
MAX_COMPANY_ALLOCATION_PCT=15.0

# ==============================================================================
# ETF CACHE CONFIGURATION
# ==============================================================================
ETF_CACHE_TTL_DAYS=30

# ==============================================================================
# GOOGLE DRIVE INTEGRATION
# ==============================================================================
GDRIVE_CLIENT_SECRET_FILE=secrets/credentials.json
GDRIVE_TOKEN_FILE=secrets/token.json
GDRIVE_CONFIG_FOLDER_ID=your_config_folder_id
GDRIVE_SNAPSHOT_FOLDER_ID=your_snapshot_folder_id
GDRIVE_REPORTS_FOLDER_ID=your_reports_folder_id
GDRIVE_DATABASE_FOLDER_ID=your_database_folder_id

# ==============================================================================
# GEMINI AI INTEGRATION
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# ==============================================================================
# SMTP / EMAIL NOTIFICATIONS CONFIGURATION
# ==============================================================================
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_username
SMTP_PASSWORD=your_password
ALERT_EMAIL_RECIPIENT=user@example.com

# ==============================================================================
# DISCORD NOTIFICATIONS INTEGRATION
# ==============================================================================
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
DISCORD_TEST_MODE=False
